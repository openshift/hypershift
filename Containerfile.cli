FROM brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_golang_1.26 AS builder
ARG COMMIT_HASH

WORKDIR /hypershift

# Local builds: .git/ is not copied into the builder, so the Makefile's
# git rev-parse fallback for COMMIT_HASH will not work. Pass it explicitly:
#   podman build -f Containerfile.cli --build-arg COMMIT_HASH=$(git rev-parse HEAD) --no-cache .

# TODO: switch to COPY --parents once CNTRLPLANE-4112 lands in Konflux
# Direct dependencies
COPY go.mod go.mod
COPY go.sum go.sum
COPY Makefile Makefile
COPY api/ api/
COPY pkg/ pkg/
COPY product-cli/ product-cli/
# cmd/ — only first-level packages reachable from product-cli's import graph.
# Excludes: bastion/, consolelogs/, create/, destroy/, dump/, fix/, install/.
# Within cmd/cluster/ and cmd/nodepool/, some platform sub-packages (gcp,
# powervs) are not imported but are included at directory level to keep the
# copy list maintainable. The Go compiler excludes unreferenced packages
# from the binary, so they only affect build-context size.
COPY cmd/cluster/ cmd/cluster/
COPY cmd/infra/azure/ cmd/infra/azure/
COPY cmd/kubeconfig/ cmd/kubeconfig/
COPY cmd/log/ cmd/log/
COPY cmd/nodepool/ cmd/nodepool/
COPY cmd/oadp/ cmd/oadp/
COPY cmd/util/ cmd/util/
COPY cmd/version/ cmd/version/
# support/ is a shared utility library with many transitive imports across
# cmd/ and operator packages. Narrowing to individual sub-packages is fragile.
COPY support/ support/
COPY vendor/ vendor/
# Indirect dependencies (via cmd/cluster/core/dump.go, see CNTRLPLANE-4092)
COPY control-plane-operator/ control-plane-operator/
COPY hypershift-operator/ hypershift-operator/
COPY kubevirtexternalinfra/ kubevirtexternalinfra/

RUN make product-cli-release && \
    # Create tar.gz files for Linux architectures \
    for ARCH in amd64 arm64 ppc64le s390x; do \
      tar -czvf ./bin/hcp-linux-${ARCH}.tar.gz -C ./bin/linux/${ARCH} ./hcp || exit 1; \
    done && \
    # Create tar.gz files for Darwin and Windows architectures \
    for OS in darwin windows; do \
      for ARCH in amd64 arm64; do \
        tar -czvf ./bin/hcp-${OS}-${ARCH}.tar.gz -C ./bin/${OS}/${ARCH} ./hcp || exit 1; \
      done; \
    done && \
    # Remove OS/arch subdirectories, keep only flat tar.gz files \
    find ./bin -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} +

# PQC-enabled crypto policy for ACM 5.0 / MCE 5.0 (OpenSSL DEFAULT:PQ).
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:latest AS policy

FROM registry.redhat.io/ubi9/nginx-124:latest

COPY --from=policy /etc/crypto-policies /etc/crypto-policies
COPY --from=builder /hypershift/bin/ /opt/app-root/src/

CMD ["nginx", "-g", "daemon off;"]

LABEL name="multicluster-engine/hypershift-cli-rhel9" \
      cpe="cpe:/a:redhat:multicluster_engine:5.0::el9" \
      description="HyperShift HCP CLI is to manage the lifecycle of Hosted Clusters in command lines" \
      summary="HyperShift HCP CLI" \
      url="https://catalog.redhat.com/software/containers/multicluster-engine/hypershift-cli-rhel9/" \
      version=5.0 \
      com.redhat.component="multicluster-engine-hypershift-cli-container" \
      io.openshift.tags="data,images" \
      io.k8s.display-name="multicluster-engine-hypershift-cli" \
      io.k8s.description="HyperShift HCP CLI is to manage the lifecycle of Hosted Clusters in command lines."
